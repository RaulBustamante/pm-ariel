APP_NAME="Gestion de Proyectos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gp.potenciaai.com
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pm_ariel
DB_USERNAME=pm_ariel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=gp.potenciaai.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@potenciaai.com"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_DESTINATION=/backups
BACKUP_KEEP=14
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_MYSQL_SSL=false

BRANDING_NAME="Gestion de Proyectos"
BRANDING_SHORT_NAME="GP"
BRANDING_TAGLINE="Planea, controla y reporta"
BRANDING_CONTACT_EMAIL="admin@potenciaai.com"
BRANDING_ADMIN_EMAIL="admin@potenciaai.com"

INITIATION_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

APP_HTTP_PORT=8088
